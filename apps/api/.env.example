# Local development only. For a host PostgreSQL server, use its host and port.
DATABASE_URL=postgresql://postgres:brewlite-secret@localhost:5433/brewlite
JWT_SECRET=replace-with-a-long-local-only-secret
SEED_DEMO_PASSWORD=replace-with-local-demo-password

# Payment sandbox settings. Provider credentials are issued by each gateway.
PAYMENT_TTL_MINUTES=15
PAYMENT_API_PUBLIC_URL=https://your-public-api.example
PAYMENT_WEB_PUBLIC_URL=http://localhost:3000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

@startuml activity-checkout
' Activity diagram for the current checkout API flow.
' Failure branches describe supported behavior; verify them with the API tests.
!pragma useVerticalIf on
skinparam BackgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
  BackgroundColor #FFF9E9
  BorderColor #9E501C
  FontColor #283445
  DiamondBackgroundColor #FFF0CA
  DiamondBorderColor #A96520
  ArrowColor #4E6178
  StartColor #237A5E
  EndColor #A84A44
  BarColor #4E6178
}
skinparam ArrowFontColor #334155
skinparam TitleFontColor #1D3553

title A2-07 - Activity Diagram: Đặt hàng và thanh toán BrewLite\n(Menu -> Chi tiết -> Giỏ hàng -> Đặt đơn -> VNPay Sandbox -> Theo dõi)

|Khách hàng|
start
:Mở BrewLite; xem menu;
|Next.js (Frontend)|
:Gọi GET /products;\nHiển thị menu;
|Khách hàng|
:Chọn đồ uống, size, topping;\nThêm vào giỏ hàng;
|Next.js (Frontend)|
:Hiển thị giỏ và tổng tiền;
if (Giỏ hàng trống?) then (Có)
  :Thông báo giỏ trống;
  stop
else (Không)
endif

|Khách hàng|
:Chọn Tiến hành thanh toán;
|Next.js (Frontend)|
if (Đã có access token?) then (Không)
  :Chuyển đến /login?redirect=/checkout;
  |Khách hàng|
  :Đăng nhập;
  |Next.js (Frontend)|
  :Gửi POST /auth/login;
  if (Đăng nhập thành công?) then (Không)
    :Báo lỗi; giữ nguyên giỏ hàng;
    stop
  else (Có)
    :Lưu access token;
  endif
else (Có)
endif
:Gửi GET /users/me;
|NestJS API / PostgreSQL|
:Xác thực JWT;\nTrả profile và loyaltyPoints;
|Next.js (Frontend)|
:Hiển thị điểm hiện có;
|Khách hàng|
:Kiểm tra món đã chọn;\nChọn VNPay Sandbox;\nCó thể dùng mã giảm giá / điểm thưởng;
|Next.js (Frontend)|
if (Có mã khuyến mãi?) then (Có)
  :Gửi POST /orders/promotion-preview\n{ items, promotionCode };
  |NestJS API / PostgreSQL|
  :Tính quote từ giá server;\nKhông tạo đơn, không trừ tồn;
  |Next.js (Frontend)|
  :Hiển thị mức giảm và tổng tạm tính;
else (Không)
endif
:Gửi POST /orders\n{ items, promotionCode? };
|NestJS API / PostgreSQL|
:Xác thực JWT;\nĐọc giá sản phẩm và công thức nguyên liệu;
:Kiểm tra rồi trừ tồn nguyên liệu\ntrong transaction tạo đơn;
if (Dữ liệu hợp lệ và đủ tồn?) then (Không)
  :Rollback; không tạo đơn;
  |Next.js (Frontend)|
  :Hiển thị lỗi; giữ giỏ để chỉnh sửa;
  stop
else (Có)
  :Tính lại giá/khuyến mãi từ server;
  :Tạo Order và OrderItem;\nTrạng thái PENDING;
endif

|Next.js (Frontend)|
if (Tạo được phiên VNPay?) then (Có)
  :Hiển thị /checkout/qr;\nQR mở phiên thanh toán VNPay;
  |Khách hàng|
  :Hoàn tất thanh toán trên VNPay Sandbox;
else (Không)
  |Next.js (Frontend)|
  :Hiển thị lỗi tạo phiên thanh toán;
  stop
endif
:Gọi GET /orders/:id để tải chi tiết;
|NestJS API / PostgreSQL|
:Kiểm tra quyền sở hữu;\nTrả chi tiết đơn;
|Khách hàng|
:Xem lại đơn và xác nhận thanh toán mô phỏng;
|Next.js (Frontend)|
:Lấy/tạo Idempotency-Key;
:Gửi POST /payments\n{ orderId, method, pointsToRedeem }\nHeader: Idempotency-Key;
|NestJS API / PostgreSQL|
:Kiểm tra Idempotency-Key;\nTránh ghi nhận thanh toán trùng;
 :Chờ IPN VNPay có chữ ký hợp lệ;
if (IPN xác thực thành công?) then (Không)
  :Payment FAILED; Order PAYMENT_FAILED;
  |Next.js (Frontend)|
  :Thông báo lỗi / cho phép thử lại;\nKHÔNG xóa giỏ hàng;
  stop
else (Có)
  :Payment SUCCESS; Order PAID;
endif

|Next.js (Frontend)|
if (Kết quả trả về PAYMENT_FAILED?) then (Có)
  :Giữ giỏ hàng;\nCho phép thử lại với key mới;
  stop
else (Không)
endif
:Xóa các mặt hàng đã mua khỏi giỏ;
:Hiển thị /checkout/success?orderId=...;
|Khách hàng|
:Mở lịch sử để theo dõi trạng thái đơn;
|Next.js (Frontend)|
:Gọi GET /orders/me;
|NestJS API / PostgreSQL|
:Trả { userId, orders } của người dùng;
|Next.js (Frontend)|
:Hiển thị trạng thái mới nhất:\nPENDING / PAID / PAYMENT_FAILED /\nPREPARING / READY / COMPLETED / CANCELLED;
|Khách hàng|
stop

@enduml

@startuml activity-checkout
' A2-07 / Task 2.1: matched to current Next.js checkout + NestJS + signed VNPay IPN.
' Production provider redirect is NOT authoritative; only verified IPN settles payment.
!pragma useVerticalIf on
skinparam shadowing false
skinparam activity {
  BackgroundColor #F0F5FA
  BorderColor #365675
  FontColor #162B44
  DiamondBackgroundColor #FFF2D6
  DiamondBorderColor #A56816
  BarColor #356E82
}
skinparam ArrowColor #43617D
skinparam DefaultFontName Arial

title A2-07 - BrewLite Activity: Menu -> Checkout -> VNPay IPN -> Order history

|Khách hàng|
start
:Vào menu; chọn sản phẩm, size, topping;
|Next.js UI|
:Gọi GET /products (và /products/:id);
:Thêm món và tính tạm tính vào giỏ;
if (Giỏ hàng có món hợp lệ?) then (Không)
  :Thông báo giỏ trống;
  stop
else (Có)
endif

|Khách hàng|
:Chọn thanh toán;
|Next.js UI|
if (Có access token?) then (Không)
  :Chuyển /login?next=%2Fcheckout;
  |Khách hàng|
  :Đăng nhập hoặc đăng ký;
  |Next.js UI|
  :POST /auth/login hoặc /auth/register;
  if (Xác thực thành công?) then (Không)
    :Hiển thị lỗi; giữ nguyên giỏ;
    stop
  else (Có)
    :Lưu token; quay lại /checkout;
  endif
else (Có)
endif

|Next.js UI|
:GET /users/me (Bearer JWT); tải điểm;
|NestJS API + PostgreSQL|
:Xác minh JWT và vai trò CUSTOMER;
if (JWT hợp lệ?) then (Không)
  |Next.js UI|
  :Yêu cầu đăng nhập lại; giữ giỏ;
  stop
else (Có)
endif
|Khách hàng|
:Chọn mã giảm giá và/hoặc điểm (tùy chọn);
|Next.js UI|
if (Có mã giảm giá?) then (Có)
  :POST /orders/promotion-preview;
  |NestJS API + PostgreSQL|
  :Kiểm tra mã, tính tiền từ dữ liệu server;
  if (Mã hợp lệ?) then (Không)
    |Next.js UI|
    :Báo lỗi; yêu cầu sửa/xóa mã;
    stop
  else (Có)
    |Next.js UI|
    :Hiển thị quote sau giảm;
  endif
else (Không)
endif

|Next.js UI|
:Kiểm tra điểm và gửi POST /orders;
|NestJS API + PostgreSQL|
:Validate DTO/JWT; BEGIN transaction;
:Đọc giá và công thức; trừ tồn nguyên liệu có điều kiện;
if (Đủ tồn và dữ liệu hợp lệ?) then (Không)
  :ROLLBACK; không tạo Order;
  |Next.js UI|
  :Hiển thị lỗi; giữ món trong giỏ;
  stop
else (Có)
  :Tạo Order + OrderItem (PENDING); COMMIT;
endif
|Next.js UI|
:Chuyển /checkout/qr?orderId=...;
:GET /orders/:id; tạo UUID Idempotency-Key;
:Gửi POST /payments (VNPAY, pointsToRedeem);
|NestJS API + PostgreSQL|
:Xác thực JWT/chủ đơn/số tiền/điểm;
:Transaction kiểm tra key và payment đang hoạt động;
if (Key cũ hoặc phiên PENDING khớp?) then (Có)
  :Trả phiên hiện có, không tạo payment mới;
else (Không)
  :Tạo Payment PENDING và thời hạn;
  :Sinh checkoutUrl có chữ ký VNPay;
endif
if (Tạo phiên được?) then (Không)
  :Đánh dấu lỗi khởi tạo phiên (nếu đã tạo Payment);
  |Next.js UI|
  :Báo lỗi; không coi là đã thanh toán;
  stop
else (Có)
endif
|Next.js UI|
:Hiển thị QR và link VNPay;
|Khách hàng|
:Mở và thực hiện giao dịch ở VNPay Sandbox;
|VNPay Sandbox|
:Gửi browser return (chỉ điều hướng);
:Gửi IPN đến GET /payments/webhooks/vnpay;
|NestJS API + PostgreSQL|
:Kiểm tra chữ ký, TmnCode, TxnRef và số tiền;
if (IPN hợp lệ?) then (Không)
  :Trả lỗi IPN; không xác nhận PAID;
  |Next.js UI|
  :Tiếp tục poll, chờ IPN hợp lệ/hết hạn;
  stop
else (Có)
endif
:BEGIN settlement transaction; chỉ xử lý PENDING;
if (Phiên đã hết hạn?) then (Có)
  :Payment FAILED; Order CANCELLED;
  :Hoàn tồn theo nghiệp vụ hủy đơn
  (do IPN hoặc job quét hạn);
  |Next.js UI|
  :Hiển thị đơn đã hủy / đặt lại;
  stop
else (Không)
endif
if (VNPay báo thành công?) then (Có)
  :Payment SUCCESS; Order PAID;
  :Trừ điểm đổi (nếu có); cộng điểm thưởng một lần;
else (Không)
  :Payment FAILED; Order PAYMENT_FAILED;
endif
:COMMIT; trả RspCode cho VNPay;
|Next.js UI|
:Poll GET /orders/:id mỗi 3 giây;
if (Order PAID?) then (Có)
  :Xóa CHỈ các món đã mua khỏi giỏ;
  :Chuyển /checkout/success?orderId=...;
else (Không)
  if (Order PAYMENT_FAILED?) then (Có)
    :Giữ giỏ; hiện nút Thử lại;
    |Khách hàng|
    :Nếu thử lại: chủ động gửi key MỚI;
    |NestJS API + PostgreSQL|
    :Payment mới PENDING; Order trở lại PENDING;
    stop
  else (Vẫn PENDING)
    |Next.js UI|
    :Không tự xác nhận từ browser return;
    stop
  endif
endif
|Khách hàng|
:Xem lịch sử đơn;
|Next.js UI|
:Gọi GET /orders/me;
|NestJS API + PostgreSQL|
:Trả lịch sử và trạng thái mới nhất;
|Khách hàng|
stop
@enduml

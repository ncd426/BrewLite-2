@startuml deployment
' BrewLite Assignment 2 - deployment topology aligned to the recorded GHCR/Render CD workflow.
' Production services/URLs were evidenced for historical SHA 8b9b060; current release must be rechecked.
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 50
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam PackageBorderColor #64748B
skinparam PackageFontColor #0F172A
skinparam ComponentBorderColor #475569
skinparam ComponentBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #475569
skinparam DatabaseBackgroundColor #EFF6FF
skinparam NoteBackgroundColor #FEF3C7
skinparam NoteBorderColor #D97706

title BrewLite - Deployment Diagram (Assignment 2 / Tasks 3.2 and 5.3)
subtitle Known configuration vs. release verification still required

package "LOCAL - Docker Compose" as Local #E0F2FE {
  actor "Developer browser" as LocalUser
  component "Next.js frontend\napps/web :3000" as LocalWeb
  component "NestJS backend\napps/api :4000 (default)" as LocalApi
  database "PostgreSQL 16\nHost :5433 / container :5432\nPersistent volume" as LocalDb
  component "Compose environment\n.env (never commit)" as LocalEnv
  component "Ready + logs\nGET /health, /products\nstdout / stderr" as LocalObs

  LocalUser --> LocalWeb : HTTP localhost:3000
  LocalWeb --> LocalApi : REST / JSON
  LocalApi --> LocalDb : Prisma / SQL
  LocalEnv --> LocalApi : runtime env
  LocalApi --> LocalObs : health and logs
}

package "CI / CD - GitHub Actions" as CI #F1F5F9 {
  component "GitHub PR / main\nsource + review" as Source
  component "CI quality gates\nnpm ci, lint, tests, build\nAPI + Web" as Gates
  component "CD publish\nDocker build; SHA tags\nGHCR push + digests" as Publish
  component "Production release gate\nRENDER_DEPLOY_ENABLED\nMigration-approved SHA\nGitHub environment" as GateProd
  component "Render release adapter\nDeploy digest + wait Live\nGET /health, /products, Web /" as CDRelease
  component "GitHub secret / variables\nNo values in repository" as CISecrets

  Source --> Gates : push / PR
  Gates --> Publish : main / tag only
  Publish --> GateProd : image digests
  GateProd --> CDRelease : approved main SHA
  CISecrets --> GateProd : configuration
  CISecrets --> CDRelease : API key + service IDs
}

package "PRODUCTION - documented Render/GHCR deployment" as Prod #EAF7EF {
  actor "Customer browser\nHTTPS" as User
  component "Render Web service\nNext.js image\nhttps://brewlite-2-web.onrender.com" as Web
  component "Render API service\nNestJS container\nhttps://brewlite-api-49rx.onrender.com" as Api
  database "PostgreSQL production\nDATABASE_URL at runtime\nPrivate access / backup: verify" as DB
  component "GHCR registry\nAPI + Web images\nsha-<commit> and digests" as Registry
  component "Render runtime env\nJWT, DATABASE_URL, VNPay\nSecrets (never embed)" as RuntimeConfig
  component "Render logs / health\nAPI GET /health\nGET /products; Web GET /" as Health

  User --> Web : HTTPS 443
  Web --> Api : HTTPS 443 / REST (browser)
  Api --> DB : Prisma TCP (private intended)
  RuntimeConfig --> Api : runtime secrets
  Api --> Health : health + logs
  Registry --> Api : immutable digest
  Registry --> Web : immutable digest
}

cloud "VNPay Sandbox\nExternal payment provider" as VNPay
User --> VNPay : HTTPS checkout / browser return
VNPay --> Api : HTTPS signed IPN\nGET /payments/webhooks/vnpay
CDRelease --> Api : Render deploy + smoke
CDRelease --> Web : Render deploy + smoke
Publish --> Registry : Push SHA-tagged images

note bottom of Prod
  Historical production evidence: GitHub CD run #43549122315,
  commit 8b9b0607d4b821de169d3a466866d9bdf7a1e8fd.
  Local changes are not proved deployed.
  PostgreSQL private access and backup settings need operator verification.
  Production migrations are separate from automatic CD and require review.
end note

note bottom of VNPay
  Browser return alone never settles payment.
  Only validated signed IPN may change status to PAID.
  Local simulated IPN E2E != provider-hosted payment certification.
end note
@enduml
